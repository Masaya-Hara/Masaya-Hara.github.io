5a91d35c8d33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "=", ".25"}], ",", 
     RowBox[{"c", "=", "1"}], ",", "mu", ",", "ellm", ",", "m", ",", "n", ",",
      "z", ",", "r", ",", "f", ",", "nu", ",", "ft"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mu", "=", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{"a", "+", "c"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ellm", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "^", "2"}], "-", 
        RowBox[{"a", "^", "2"}]}], ")"}], "/", 
      RowBox[{"c", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"m", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "^", "2"}], "-", 
        RowBox[{"a", "^", "2"}]}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"n", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "^", "2"}], "+", 
        RowBox[{"a", "^", "2"}]}], ")"}], "/", "2"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z", "[", "u_", "]"}], ":=", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"EllipticF", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"mu", " ", 
           RowBox[{"u", "/", "2"}]}], "-", 
          RowBox[{"Pi", "/", "4"}]}], ",", "ellm"}], "]"}]}], "+", 
      RowBox[{"c", " ", 
       RowBox[{"EllipticE", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"mu", " ", 
           RowBox[{"u", "/", "2"}]}], "-", 
          RowBox[{"Pi", "/", "4"}]}], ",", "ellm"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "[", "u_", "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"m", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"mu", " ", "u"}], "]"}]}], "+", "n"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"z", "[", "u", "]"}], ",", 
       RowBox[{
        RowBox[{"r", "[", "u", "]"}], " ", 
        RowBox[{"Cos", "[", "v", "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", "u", "]"}], " ", 
        RowBox[{"Sin", "[", "v", "]"}]}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{"Normalize", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"r", "'"}], "[", "u", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "u", "]"}], " ", 
         RowBox[{"Cos", "[", "v", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "u", "]"}], " ", 
         RowBox[{"Sin", "[", "v", "]"}]}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ft", "[", 
      RowBox[{"u_", ",", "v_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"u", ",", "v"}], "]"}], "+", 
      RowBox[{"t", " ", 
       RowBox[{"nu", "[", 
        RowBox[{"u", ",", "v"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"ft", "[", 
         RowBox[{"u", ",", "v", ",", "2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "4.75"}], ",", "6.75"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotPoints", "->", 
         RowBox[{"{", 
          RowBox[{"100", ",", "100"}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"blue", ",", 
           RowBox[{"Opacity", "[", ".3", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"MeshFunctions", "->", 
         RowBox[{"{", 
          RowBox[{"#1", "&"}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"Mesh", "->", "10"}]}], "\[IndentingNewLine]", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", "4.75"}], ",", "6.75"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotPoints", "->", 
         RowBox[{"{", 
          RowBox[{"50", ",", "50"}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"GrayLevel", "[", 
          RowBox[{".7", ",", ".7"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"MeshFunctions", "->", 
         RowBox[{"{", 
          RowBox[{"#1", "&"}], "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Boxed", "->", "False"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Background", "->", "None"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "->", 
       RowBox[{"{", 
        RowBox[{"600", ",", "600"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImagePadding", "->", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotRangePadding", "->", 
       RowBox[{"Scaled", "[", ".02", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ViewAngle", "->", ".28598564241059005"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ViewCenter", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{".5", ",", ".5", ",", ".5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{".48818359375", ",", ".5368944846827949"}], "}"}]}], 
        "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".9217395220986987"}], ",", 
         RowBox[{"-", "1.3044140050215869"}], ",", 
         RowBox[{"-", "2.982585515438712"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ViewVertical", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".3507233135430239"}], ",", ".5026162826639182", ",", 
         RowBox[{"-", ".7901708864154044"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",\

