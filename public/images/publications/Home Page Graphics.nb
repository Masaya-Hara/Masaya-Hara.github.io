Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", "1"}], ",", 
      RowBox[{"k", "=", "2"}], ",", "g", ",", "\[Omega]", ",", "f"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", "z_", "]"}], "=", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", "z"]}], 
       FractionBox[
        RowBox[{
         RowBox[{"c", 
          RowBox[{"(", 
           RowBox[{"1", "+", "k"}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "k"}], ")"}], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"k", "*", "z"}]]}]}], 
        RowBox[{
         RowBox[{"c", 
          RowBox[{"(", 
           RowBox[{"1", "-", "k"}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "k"}], ")"}], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"k", "*", "z"}]]}]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Omega]", "[", "z_", "]"}], "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"g", "[", "z", "]"}], ",", "z"}], "]"}]], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "z_", "]"}], "=", 
      RowBox[{
       RowBox[{"Re", "@", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "+", 
              SuperscriptBox[
               RowBox[{"g", "[", "z", "]"}], "2"]}], ",", 
             RowBox[{"\[ImaginaryI]", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}]}], ",", 
             RowBox[{
              RowBox[{"-", "2"}], 
              RowBox[{"g", "[", "z", "]"}]}]}], "}"}], 
