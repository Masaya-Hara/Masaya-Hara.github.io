Cell[CellGroupData[{

Cell["Maximal Darboux transformations", "Section",
 CellChangeTimes->{{3.999637476071137*^9, 3.999637480870411*^9}, {
  3.999641818635187*^9, 
  3.999641824642679*^9}},ExpressionUUID->"a5c1c500-e019-446b-a87d-\
089c93567314"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "=", "1"}], ",", 
     RowBox[{"k", "=", "2"}], ",", "g", ",", "\[Omega]", ",", "f"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ExponentialE]", "z"]}], 
      FractionBox[
       RowBox[{
        RowBox[{"c", 
         RowBox[{"(", 
          RowBox[{"1", "+", "k"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "k"}], ")"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"k", "*", "z"}]]}]}], 
       RowBox[{
        RowBox[{"c", 
         RowBox[{"(", 
          RowBox[{"1", "-", "k"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "k"}], ")"}], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"k", "*", "z"}]]}]}]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]", "[", "z_", "]"}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"g", "[", "z", "]"}], ",", "z"}], "]"}]], "//", 
      "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"f", "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{"Re", "@", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "+", 
             SuperscriptBox[
              RowBox[{"g", "[", "z", "]"}], "2"]}], ",", 
            RowBox[{"\[ImaginaryI]", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"g", "[", "z", "]"}], "2"]}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"-", "2"}], 
             RowBox[{"g", "[", "z", "]"}]}]}], "}"}], 
          RowBox[{"\[Omega]", "[", "z", "]"}]}], ",", "z"}], "]"}]}], "+", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        FractionBox["8", "3"]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"u", "+", 
        RowBox[{"\[ImaginaryI]", "*", "v"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", 
        RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
