---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import { ui, type Language } from '../data/i18n';
import { profile } from '../data/profile';
interface Props { language: Language; }
const { language } = Astro.props;
const t = ui[language];
const title = language === 'en' ? 'Masaya Hara | Differential Geometry' : '原 誠弥 | 微分幾何学';
const description = language === 'en'
  ? 'Masaya Hara is an Assistant Professor at National Institute of Technology, Anan College, working in differential geometry, integrable systems, transformation theory, and discrete differential geometry.'
  : '原 誠弥は阿南工業高等専門学校の助教で、微分幾何学、可積分系、変換理論、離散微分幾何学を研究しています。';
const canonical = new URL(language === 'en' ? '/' : '/ja/', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.romanName,
  alternateName: profile.name.ja,
  jobTitle: profile.position.en,
  affiliation: { '@type': 'Organization', name: profile.institution.en },
  url: new URL('/', Astro.site).href,
  sameAs: profile.links.map(link => link.href),
};
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    <link rel="alternate" hreflang="x-default" href="https://masaya-hara.github.io/" />
    <link rel="alternate" hreflang="en" href="https://masaya-hara.github.io/" />
    <link rel="alternate" hreflang="ja" href="https://masaya-hara.github.io/ja/" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Sidebar language={language} />
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>
