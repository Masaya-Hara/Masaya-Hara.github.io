---
import InlineMath from './InlineMath.astro';
import Authors from './Authors.astro';
import PublicationLinks from './PublicationLinks.astro';
import type { Publication } from '../data/publications';
import { ui, type Language } from '../data/i18n';
interface Props { publication: Publication; language: Language; }
const { publication: p, language } = Astro.props;
const t = ui[language];
---
<dialog id={`dialog-${p.id}`} class="publication-dialog" aria-labelledby={`dialog-title-${p.id}`}>
  <div class="dialog-content">
    <form method="dialog" class="dialog-close"><button type="submit" autofocus>{t.close} <span aria-hidden="true">×</span></button></form>
    <p class="sample-label">{t.publicationFilters[p.category]}</p>
    <h2 id={`dialog-title-${p.id}`} tabindex="-1"><InlineMath text={p.title} /></h2>
    <p class="publication-authors"><Authors authors={p.authors} /></p>
    <p>{p.type && `${p.type} · `}{p.venue}</p>
    <p>{p.bibliography ?? (p.year ?? t.yearUnknown)}{p.status === 'to-appear' && ` · ${t.toAppear}`}{p.pages && ` · pp. ${p.pages}`}</p>
    <PublicationLinks publication={p} language={language} />
    {p.imageSrc && <img class="publication-modal-image" src={p.imageSrc} alt={p.title} loading="lazy" />}
    <div class="dialog-section"><h3>{t.technicalSummary}</h3><p><InlineMath text={p.technicalSummary?.text[language] ?? t.summaryPending} /></p>{p.technicalSummary && <a class="summary-source" href={p.technicalSummary.source}>{t.source}</a>}</div>
    <div class="dialog-section"><h3>{t.relatedSurfaces}</h3>{p.relatedSurfaces?.length ? <ul>{p.relatedSurfaces.map(surface => <li><a href={surface.href}>{surface.title}</a></li>)}</ul> : <p>{t.noSurfaces}</p>}</div>
    {p.additionalImages?.length && <div class="dialog-section"><h3>{t.additionalImages}</h3>{p.additionalImages.map(image => <img src={image.src} alt={image.alt[language]} loading="lazy" />)}</div>}
  </div>
</dialog>
