---
import type { SurfaceKind } from '../data/home';

interface Props { kind?: SurfaceKind; hero?: boolean; }
const { kind = 'wave', hero = false } = Astro.props;
const lines: string[] = [];
const point = (u: number, v: number) => {
  let x = u;
  let y = v;
  let z = 0;
  if (kind === 'saddle') {
    z = 0.34 * (u * u - v * v);
  } else if (kind === 'ribbon') {
    x = (1.6 + v * 0.42 * Math.cos(u)) * Math.cos(u);
    y = (1.6 + v * 0.42 * Math.cos(u)) * Math.sin(u);
    z = v * 0.64 * Math.sin(u) + u * 0.18;
  } else {
    z = 0.85 * Math.sin(u * 1.3) * Math.cos(v * 0.75) + 0.12 * u * v;
  }
  return `${(300 + (x - y * 0.58) * 69).toFixed(2)},${(220 + (x * 0.24 + y * 0.47 - z * 0.94) * 69).toFixed(2)}`;
};

// Generate decorative wireframes at build time; no client renderer is needed.
for (let i = 0; i <= 26; i++) {
  const fixed = -2.2 + (i / 26) * 4.4;
  for (const axis of [0, 1]) {
    const points = Array.from({ length: 65 }, (_, j) => {
      const moving = -2.2 + (j / 64) * 4.4;
      return axis === 0 ? point(fixed, moving) : point(moving, fixed);
    });
    lines.push(`M${points.join(' L')}`);
  }
}
---

<svg class:list={['surface-art', { 'surface-art--hero': hero }]} viewBox="0 0 600 440" fill="none" aria-hidden="true">
  {hero && <g class="surface-guides">
    <ellipse cx="300" cy="239" rx="238" ry="145" />
    <ellipse cx="300" cy="239" rx="180" ry="109" />
    <path d="M40 239H560 M300 55V415" />
    <circle cx="300" cy="239" r="4" />
  </g>}
  <g class="surface-mesh">{lines.map(d => <path d={d} />)}</g>
</svg>
